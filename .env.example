# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>"

# OpenAI API key (required for Processor, Answerer, and Evaluator agents)
OPENAI_API_KEY="sk-..."

# (Optional) override the default MongoDB timeouts in milliseconds
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
# MONGODB_CONNECT_TIMEOUT_MS=20000
# MONGODB_SOCKET_TIMEOUT_MS=20000

# (Optional) comma-separated extra CORS origins beyond localhost:5173
# FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
